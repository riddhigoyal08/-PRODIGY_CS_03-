<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Password Strength Checker</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to right, #667eea, #764ba2);
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }

    .container {
      background: #fff;
      color: #333;
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      width: 100%;
      max-width: 400px;
      transition: 0.3s ease;
    }

    h2 {
      text-align: center;
      margin-bottom: 1.5rem;
      font-weight: 600;
      font-size: 1.8rem;
      color: #4b4b4b;
    }

    input[type="password"] {
      width: 100%;
      padding: 12px;
      border: 2px solid #ddd;
      border-radius: 10px;
      font-size: 16px;
      margin-bottom: 15px;
      outline: none;
      transition: 0.3s ease;
    }

    input[type="password"]:focus {
      border-color: #764ba2;
    }

    .progress-container {
      background-color: #e0e0e0;
      height: 12px;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0;
      transition: width 0.4s ease;
    }

    .feedback {
      margin-top: 10px;
      font-weight: 500;
    }

    .criteria {
      margin-top: 15px;
      font-size: 14px;
    }

    .criteria span {
      display: flex;
      align-items: center;
      margin-bottom: 6px;
      color: #666;
    }

    .criteria span.valid {
      color: #28a745;
    }

    .criteria span::before {
      content: '⚪';
      margin-right: 8px;
      transition: 0.2s ease;
    }

    .criteria span.valid::before {
      content: '✔️';
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Password Strength Checker</h2>
    <input type="password" id="passwordInput" placeholder="Enter your password" oninput="checkPasswordStrength()" />
    <div class="progress-container">
      <div id="progressBar" class="progress-bar"></div>
    </div>
    <div class="feedback" id="feedbackText"></div>

    <div class="criteria">
      <span id="length">At least 8 characters</span>
      <span id="lower">Contains lowercase letters</span>
      <span id="upper">Contains uppercase letters</span>
      <span id="number">Contains numbers</span>
      <span id="special">Contains special characters</span>
    </div>
  </div>

  <script>
    function checkPasswordStrength() {
      const password = document.getElementById('passwordInput').value;
      const progressBar = document.getElementById('progressBar');
      const feedbackText = document.getElementById('feedbackText');

      const criteria = {
        length: password.length >= 8,
        lower: /[a-z]/.test(password),
        upper: /[A-Z]/.test(password),
        number: /[0-9]/.test(password),
        special: /[^A-Za-z0-9]/.test(password),
      };

      // Update criteria UI
      for (let key in criteria) {
        document.getElementById(key).classList.toggle('valid', criteria[key]);
      }

      let passed = Object.values(criteria).filter(v => v).length;

      let strength = ['Weak', 'Moderate', 'Strong', 'Very Strong'];
      let color = ['#ff4d4d', '#ff9900', '#f1c40f', '#2ecc71'];
      let width = [25, 50, 75, 100];

      if (password.length === 0) {
        progressBar.style.width = '0%';
        feedbackText.textContent = '';
        return;
      }

      progressBar.style.width = `${width[passed - 1] || 0}%`;
      progressBar.style.backgroundColor = color[passed - 1] || '#ddd';
      feedbackText.textContent = strength[passed - 1] || 'Very Weak';
    }
  </script>
</body>
</html>
